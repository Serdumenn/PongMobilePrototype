<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="scrim" />
    <ui:VisualElement class="safe overlay" picking-mode="Ignore">
        <ui:VisualElement class="card">
            <ui:VisualElement name="mascot" class="card__mascot" picking-mode="Ignore" />
            <ui:Label name="title" text="You win!" class="card__title" picking-mode="Ignore" />
            <ui:Label name="caption" text="Portal Duel · vs Brave Otter" class="caption card__label" picking-mode="Ignore" />
            <ui:Label name="score" text="5 – 3" class="result-score" picking-mode="Ignore" />
            <ui:Label name="note" text="" class="caption rematch-note" picking-mode="Ignore" />
            <ui:Button name="friend-button" class="ghost-share result-friend">
                <ui:VisualElement name="friend-icon" class="icon icon--person-add ghost-share__icon" picking-mode="Ignore" />
                <ui:Label name="friend-label" text="Add friend" class="ghost-share__label" picking-mode="Ignore" />
            </ui:Button>
            <ui:VisualElement class="card__actions" picking-mode="Ignore">
                <ui:Button name="home-button" class="btn btn--secondary">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--home" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="rematch-button" class="btn btn--primary">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--retry icon--light" picking-mode="Ignore" />
                        <ui:Label name="rematch-label" text="Rematch" class="btn__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
