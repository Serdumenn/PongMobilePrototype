<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="missions-scrim" class="scrim" />
    <ui:VisualElement class="safe overlay" picking-mode="Ignore">
        <ui:VisualElement class="card missions-card">
            <ui:VisualElement name="mascot" class="card__mascot" picking-mode="Ignore" />
            <ui:Label text="Daily missions" class="card__title" picking-mode="Ignore" />
            <ui:Label name="missions-note" text="New missions every day" class="caption card__subtitle" picking-mode="Ignore" />
            <ui:VisualElement class="missions-list" picking-mode="Ignore">
                <ui:VisualElement name="mission-0" class="mission" picking-mode="Ignore">
                    <ui:VisualElement name="mission-0-badge" class="mission__badge" picking-mode="Ignore">
                        <ui:VisualElement name="mission-0-icon" class="icon icon--light" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mission__body" picking-mode="Ignore">
                        <ui:Label name="mission-0-text" text="" class="mission__text" picking-mode="Ignore" />
                        <ui:VisualElement class="mission__track" picking-mode="Ignore">
                            <ui:VisualElement name="mission-0-fill" class="mission__fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="mission-0-count" text="" class="mission__count" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="mission-1" class="mission" picking-mode="Ignore">
                    <ui:VisualElement name="mission-1-badge" class="mission__badge" picking-mode="Ignore">
                        <ui:VisualElement name="mission-1-icon" class="icon icon--light" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mission__body" picking-mode="Ignore">
                        <ui:Label name="mission-1-text" text="" class="mission__text" picking-mode="Ignore" />
                        <ui:VisualElement class="mission__track" picking-mode="Ignore">
                            <ui:VisualElement name="mission-1-fill" class="mission__fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="mission-1-count" text="" class="mission__count" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="mission-2" class="mission" picking-mode="Ignore">
                    <ui:VisualElement name="mission-2-badge" class="mission__badge" picking-mode="Ignore">
                        <ui:VisualElement name="mission-2-icon" class="icon icon--light" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mission__body" picking-mode="Ignore">
                        <ui:Label name="mission-2-text" text="" class="mission__text" picking-mode="Ignore" />
                        <ui:VisualElement class="mission__track" picking-mode="Ignore">
                            <ui:VisualElement name="mission-2-fill" class="mission__fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="mission-2-count" text="" class="mission__count" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="missions-reward" picking-mode="Ignore">
                <ui:VisualElement name="reward-art" class="missions-reward__art" picking-mode="Ignore" />
                <ui:VisualElement class="mission__body" picking-mode="Ignore">
                    <ui:Label name="reward-title" text="" class="mission__text" picking-mode="Ignore" />
                    <ui:VisualElement class="mission__track" picking-mode="Ignore">
                        <ui:VisualElement name="reward-fill" class="mission__fill mission__fill--reward" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="missions-stars" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--star" picking-mode="Ignore" />
                    <ui:Label name="stars-count" text="" class="missions-stars__label" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="card__actions" picking-mode="Ignore">
                <ui:Button name="back-button" class="btn btn--primary">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--check icon--light" picking-mode="Ignore" />
                        <ui:Label text="Done" class="btn__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
