<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="safe" picking-mode="Ignore">
        <ui:VisualElement class="topbar" picking-mode="Ignore">
            <ui:Button name="back-button" class="btn btn--icon">
                <ui:VisualElement class="btn__face" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--back" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:Button>
            <ui:Label text="Collection" class="screen-title" picking-mode="Ignore" />
            <ui:VisualElement class="topbar__side topbar__side--gold" picking-mode="Ignore">
                <ui:VisualElement class="gold-chip" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--coin" picking-mode="Ignore" />
                    <ui:Label name="gold-balance" text="" class="gold-chip__label" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="tabs fit-group" picking-mode="Ignore">
            <ui:Button name="tab-ball" text="Pingi" class="tab" />
            <ui:Button name="tab-paddle" text="Paddles" class="tab" />
            <ui:Button name="tab-theme" text="Themes" class="tab" />
            <ui:Button name="tab-effect" text="Effects" class="tab" />
        </ui:VisualElement>
        <ui:ScrollView name="shop-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="shop-scroll">
            <ui:VisualElement name="showcase" class="shop-panel showcase" picking-mode="Ignore">
                <ui:VisualElement class="shop-panel__head" picking-mode="Ignore">
                    <ui:Label text="Today's picks" class="shop-panel__title" picking-mode="Ignore" />
                    <ui:VisualElement class="shop-timer" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--clock" picking-mode="Ignore" />
                        <ui:Label name="showcase-timer" text="00:00:00" class="shop-timer__label fit-skip" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="showcase-row" class="shop-row" picking-mode="Ignore" />
                <ui:Label name="showcase-hint" text="" class="shop-panel__hint" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="season" class="shop-panel season" picking-mode="Ignore">
                <ui:VisualElement class="shop-panel__head" picking-mode="Ignore">
                    <ui:Label name="season-title" text="" class="shop-panel__title" picking-mode="Ignore" />
                    <ui:Label name="season-days" text="" class="shop-timer shop-timer__label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="season-row" class="shop-row" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Button name="pass-button" class="offer offer--pass">
                <ui:VisualElement class="offer__face" picking-mode="Ignore">
                    <ui:VisualElement name="pass-art" class="offer__art" picking-mode="Ignore" />
                    <ui:VisualElement class="offer__text" picking-mode="Ignore">
                        <ui:Label text="Pingi Pass" class="offer__title" picking-mode="Ignore" />
                        <ui:Label text="All items + Golden set" class="offer__sub" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="pass-price" text="..." class="price" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:Button>
            <ui:VisualElement name="effect-filters" class="filters" picking-mode="Ignore">
                <ui:Button name="filter-trail" text="Trails" class="filter" />
                <ui:Button name="filter-hit" text="Hits" class="filter" />
                <ui:Button name="filter-party" text="Parties" class="filter" />
                <ui:Button name="filter-frame" text="Frames" class="filter" />
                <ui:Button name="filter-sets" text="Sets" class="filter" />
                <ui:Button name="filter-box" text="Box" class="filter" />
            </ui:VisualElement>
            <ui:VisualElement name="grid" class="grid" picking-mode="Ignore" />
            <ui:VisualElement name="sets" class="sets" picking-mode="Ignore" />
            <ui:VisualElement name="box" class="shop-panel box-panel" picking-mode="Ignore">
                <ui:Label text="Surprise box" class="shop-panel__title box-panel__title" picking-mode="Ignore" />
                <ui:VisualElement class="box-stage" picking-mode="Ignore">
                    <ui:VisualElement name="box-gift" class="gift" picking-mode="Ignore">
                        <ui:VisualElement class="gift__body" picking-mode="Ignore" />
                        <ui:VisualElement class="gift__lid" picking-mode="Ignore" />
                        <ui:VisualElement class="gift__ribbon" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="box-prize" class="box-prize" picking-mode="Ignore">
                        <ui:VisualElement name="box-prize-art" class="item__art" picking-mode="Ignore" />
                        <ui:Label name="box-prize-name" text="" class="box-prize__name" picking-mode="Ignore" />
                        <ui:Label name="box-prize-tier" text="" class="box-prize__tier" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="box-odds" text="" class="shop-panel__hint" picking-mode="Ignore" />
                <ui:Label text="Never gives an item you already have." class="shop-panel__hint" picking-mode="Ignore" />
                <ui:Button name="box-open" class="btn btn--gold btn--buy box-open">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--coin" picking-mode="Ignore" />
                        <ui:Label name="box-open-label" text="" class="btn__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="noads-button" class="offer offer--noads">
                <ui:VisualElement class="offer__face" picking-mode="Ignore">
                    <ui:Label text="Remove ads" class="offer__title offer__title--grow" picking-mode="Ignore" />
                    <ui:Label name="noads-price" text="..." class="price" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:Button>
            <ui:VisualElement class="shop-end" picking-mode="Ignore" />
        </ui:ScrollView>
    </ui:VisualElement>
    <ui:VisualElement name="dialog" class="dialog dialog--hidden">
        <ui:VisualElement name="dialog-scrim" class="scrim" />
        <ui:VisualElement class="safe overlay" picking-mode="Ignore">
            <ui:VisualElement class="card">
                <ui:VisualElement name="dialog-art" class="card__mascot" picking-mode="Ignore" />
                <ui:Label name="dialog-title" text="Kitty" class="card__title" picking-mode="Ignore" />
                <ui:Label name="dialog-text" text="" class="caption dialog__text" picking-mode="Ignore" />
                <ui:VisualElement name="dialog-dots" class="dots" picking-mode="Ignore" />
                <ui:Button name="dialog-primary" class="btn btn--primary btn--wide">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement name="dialog-primary-icon" class="icon icon--play icon--light" picking-mode="Ignore" />
                        <ui:Label name="dialog-primary-label" text="Watch ad" class="btn__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="dialog-gold" class="btn btn--gold btn--buy">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--coin" picking-mode="Ignore" />
                        <ui:Label name="dialog-gold-label" text="" class="btn__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="dialog-buy" class="btn btn--buy">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:Label name="dialog-buy-label" text="Buy" class="btn__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="dialog-pass" text="or unlock everything with Pingi Pass" class="link" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
