<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="fog" class="fog fog--hidden" picking-mode="Ignore">
        <ui:VisualElement class="fog__band fog__band--soft" picking-mode="Ignore" />
        <ui:VisualElement class="fog__band" picking-mode="Ignore" />
        <ui:VisualElement class="fog__band fog__band--soft" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement class="safe" picking-mode="Ignore">
        <ui:VisualElement name="rivals" class="rivals" picking-mode="Ignore" />
        <ui:VisualElement name="attack-banner" class="attack-banner attack-banner--hidden" picking-mode="Ignore">
            <ui:VisualElement name="attack-icon" class="icon icon--fog" picking-mode="Ignore" />
            <ui:Label name="attack-text" text="Fog incoming! Hit a Perfect to block" class="attack-banner__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="rush-note" text="" class="ink-chip rush-note rush-note--hidden" picking-mode="Ignore" />
        <ui:Label name="rush-wait" text="Time's up! Waiting for the others…" class="ink-chip rush-wait" picking-mode="Ignore" />
        <ui:VisualElement class="ohud-center" picking-mode="Ignore">
            <ui:Label name="rush-count" text="3" class="ohud-count" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="float-layer" class="float-layer" picking-mode="Ignore" />
        <ui:VisualElement class="spacer" picking-mode="Ignore" />
        <ui:VisualElement class="ohud-bottom" picking-mode="Ignore">
            <ui:VisualElement name="reaction-bar" class="reaction-bar reaction-bar--hidden" picking-mode="Ignore">
                <ui:Button name="react-0" class="btn reaction-btn">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--thumb" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="react-1" class="btn reaction-btn">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--wow" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="react-2" class="btn reaction-btn">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--laugh" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="react-3" class="btn reaction-btn">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--flame" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="react-toggle" class="btn reaction-toggle">
                <ui:VisualElement class="btn__face" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--laugh" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="leave-dialog" class="dialog dialog--hidden">
        <ui:VisualElement name="leave-scrim" class="scrim" />
        <ui:VisualElement class="safe overlay" picking-mode="Ignore">
            <ui:VisualElement class="card online-card">
                <ui:Label text="Leave match?" class="card__title" picking-mode="Ignore" />
                <ui:Label text="Your run ends and the others play on." class="caption dialog__text" picking-mode="Ignore" />
                <ui:Button name="leave-confirm" class="btn btn--primary btn--wide">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:Label text="Leave" class="btn__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="leave-cancel" text="Keep playing" class="link" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
