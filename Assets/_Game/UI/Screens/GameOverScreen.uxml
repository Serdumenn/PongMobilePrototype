<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="scrim" />
    <ui:VisualElement class="safe overlay" picking-mode="Ignore">
        <ui:VisualElement class="card">
            <ui:VisualElement name="mascot" class="card__mascot" picking-mode="Ignore" />
            <ui:Label name="title" text="So close!" class="card__title" picking-mode="Ignore" />
            <ui:Label name="score-caption" text="Score" class="caption card__label" picking-mode="Ignore" />
            <ui:Label name="final-score" text="0" class="card__number" picking-mode="Ignore" />
            <ui:Label name="best-line" text="Best 0" class="caption" picking-mode="Ignore" />
            <ui:Label name="new-best-badge" text="New best!" class="badge" picking-mode="Ignore" />
            <ui:VisualElement class="card__actions" picking-mode="Ignore">
                <ui:Button name="home-button" class="btn btn--secondary">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--home" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="retry-button" class="btn btn--primary">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--retry icon--light" picking-mode="Ignore" />
                        <ui:Label text="Play again" class="btn__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
