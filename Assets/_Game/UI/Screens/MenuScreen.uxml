<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="safe" picking-mode="Ignore">
        <ui:VisualElement class="topbar topbar--menu" picking-mode="Ignore">
            <ui:VisualElement class="topbar__group topbar__group--left" picking-mode="Ignore">
                <ui:Button name="settings-button" class="btn btn--icon">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--settings" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="level-button" class="btn btn--icon level-chip">
                    <ui:VisualElement class="btn__face level-chip__face" picking-mode="Ignore">
                        <ui:Label name="level-caption" text="Level" class="level-chip__caption" picking-mode="Ignore" />
                        <ui:Label name="level-number" text="1" class="level-chip__number fit-skip" picking-mode="Ignore" />
                        <ui:VisualElement class="level-chip__track" picking-mode="Ignore">
                            <ui:VisualElement name="level-fill" class="level-chip__fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="topbar__group" picking-mode="Ignore">
                <ui:Button name="missions-button" class="btn btn--icon missions-button">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--star" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="missions-count" text="" class="missions-button__count fit-skip" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="scores-button" class="btn btn--icon">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--rank" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="shop-button" class="btn btn--icon">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--wardrobe" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="spacer" picking-mode="Ignore" />
        <ui:VisualElement class="title" picking-mode="Ignore">
            <ui:Label text="Pingi" class="title__line title__line--pingi" picking-mode="Ignore" />
            <ui:Label text="Pongi" class="title__line title__line--pongi" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="spacer" picking-mode="Ignore" />
        <ui:VisualElement name="mode-strip" class="mode-strip">
            <ui:VisualElement name="mode-track" class="mode-track" picking-mode="Ignore">
                <ui:VisualElement name="mode-card" class="mode-card" picking-mode="Ignore">
                    <ui:VisualElement name="mode-art" class="mode-card__art" picking-mode="Ignore" />
                    <ui:Label name="mode-name" text="Classic" class="mode-card__name" picking-mode="Ignore" />
                    <ui:Label name="mode-tagline" text="" class="caption mode-card__tagline" picking-mode="Ignore" />
                    <ui:VisualElement name="mode-best" class="mode-card__best" picking-mode="Ignore">
                        <ui:VisualElement name="mode-best-icon" class="icon icon--crown mode-card__best-icon" picking-mode="Ignore" />
                        <ui:Label name="mode-best-label" text="Best 0" class="mode-card__best-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="mode-card-prev" class="mode-card mode-card--peek mode-card--prev" picking-mode="Ignore">
                    <ui:VisualElement class="mode-card__art" picking-mode="Ignore" />
                    <ui:Label text="" class="mode-card__name" picking-mode="Ignore" />
                    <ui:Label text="" class="caption mode-card__tagline" picking-mode="Ignore" />
                    <ui:VisualElement class="mode-card__best" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--crown mode-card__best-icon" picking-mode="Ignore" />
                        <ui:Label text="" class="mode-card__best-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="mode-card-next" class="mode-card mode-card--peek mode-card--next" picking-mode="Ignore">
                    <ui:VisualElement class="mode-card__art" picking-mode="Ignore" />
                    <ui:Label text="" class="mode-card__name" picking-mode="Ignore" />
                    <ui:Label text="" class="caption mode-card__tagline" picking-mode="Ignore" />
                    <ui:VisualElement class="mode-card__best" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--crown mode-card__best-icon" picking-mode="Ignore" />
                        <ui:Label text="" class="mode-card__best-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="swipe-hint" class="swipe-hint swipe-hint--hidden" picking-mode="Ignore">
                <ui:VisualElement class="icon icon--drag" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="mode-dots" class="mode-dots" picking-mode="Ignore" />
        <ui:VisualElement class="spacer spacer--2" picking-mode="Ignore" />
        <ui:Button name="play-button" class="btn btn--play menu-play">
            <ui:VisualElement class="btn__face" picking-mode="Ignore">
                <ui:VisualElement class="icon icon--play" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:Button>
        <ui:VisualElement class="world-reserve" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
