<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="Hud" src="HudScreen.uxml" />
    <ui:Template name="Menu" src="MenuScreen.uxml" />
    <ui:Template name="Settings" src="SettingsScreen.uxml" />
    <ui:Template name="Pause" src="PauseScreen.uxml" />
    <ui:Template name="GameOver" src="GameOverScreen.uxml" />
    <ui:Template name="Shop" src="ShopScreen.uxml" />
    <ui:Template name="Reward" src="RewardScreen.uxml" />
    <ui:Template name="Scores" src="ScoresScreen.uxml" />
    <ui:Template name="Hub" src="HubScreen.uxml" />
    <ui:Template name="MatchSetup" src="MatchSetupScreen.uxml" />
    <ui:Template name="MatchHud" src="MatchHudScreen.uxml" />
    <ui:Template name="MatchResult" src="MatchResultScreen.uxml" />
    <ui:Template name="Lobby" src="LobbyScreen.uxml" />
    <ui:Template name="OnlineHud" src="OnlineHudScreen.uxml" />
    <ui:Template name="OnlineResult" src="OnlineResultScreen.uxml" />
    <ui:Template name="RushBattle" src="RushBattleScreen.uxml" />
    <ui:Template name="RushResult" src="RushResultScreen.uxml" />
    <ui:Template name="GhostRace" src="GhostRaceScreen.uxml" />
    <ui:Template name="GhostResult" src="GhostResultScreen.uxml" />
    <ui:Template name="GhostCode" src="GhostCodeScreen.uxml" />
    <ui:Template name="Friends" src="FriendsScreen.uxml" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:Instance template="Hud" name="hud" class="screen" picking-mode="Ignore" />
        <ui:Instance template="Menu" name="menu" class="screen" picking-mode="Ignore" />
        <ui:Instance template="Settings" name="settings" class="screen screen--solid" />
        <ui:Instance template="Shop" name="shop" class="screen screen--solid" />
        <ui:Instance template="Scores" name="scores" class="screen screen--solid" />
        <ui:Instance template="Hub" name="hub" class="screen screen--solid" />
        <ui:Instance template="MatchSetup" name="match-setup" class="screen screen--solid" />
        <ui:Instance template="Lobby" name="lobby" class="screen screen--solid" />
        <ui:Instance template="Friends" name="friends" class="screen screen--solid" />
        <ui:Instance template="MatchHud" name="match-hud" class="screen" picking-mode="Ignore" />
        <ui:Instance template="MatchResult" name="match-result" class="screen" picking-mode="Ignore" />
        <ui:Instance template="OnlineHud" name="online-hud" class="screen" picking-mode="Ignore" />
        <ui:Instance template="OnlineResult" name="online-result" class="screen" picking-mode="Ignore" />
        <ui:Instance template="RushBattle" name="rush-battle" class="screen" picking-mode="Ignore" />
        <ui:Instance template="RushResult" name="rush-result" class="screen" picking-mode="Ignore" />
        <ui:Instance template="GhostRace" name="ghost-race" class="screen" picking-mode="Ignore" />
        <ui:Instance template="GhostResult" name="ghost-result" class="screen" picking-mode="Ignore" />
        <ui:Instance template="Pause" name="pause" class="screen" picking-mode="Ignore" />
        <ui:Instance template="GameOver" name="game-over" class="screen" picking-mode="Ignore" />
        <ui:Instance template="Reward" name="reward" class="screen" picking-mode="Ignore" />
        <ui:Instance template="GhostCode" name="ghost-code" class="screen" picking-mode="Ignore" />
        <ui:VisualElement name="invite-banner" class="invite-banner invite-banner--hidden" picking-mode="Ignore">
            <ui:VisualElement class="invite-banner__card">
                <ui:VisualElement class="icon icon--people invite-banner__icon" picking-mode="Ignore" />
                <ui:VisualElement class="invite-banner__text" picking-mode="Ignore">
                    <ui:Label name="invite-title" text="Brave Otter invites you" class="invite-banner__title" picking-mode="Ignore" />
                    <ui:Label name="invite-mode" text="Portal Duel" class="invite-banner__sub" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button name="invite-join" class="btn btn--primary invite-banner__join">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:Label text="Join" class="btn__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="invite-close" class="btn invite-banner__close">
                    <ui:VisualElement class="btn__face" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--close" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="toast" class="toast toast--hidden" picking-mode="Ignore">
            <ui:VisualElement class="toast__pill" picking-mode="Ignore">
                <ui:Label name="toast-label" text="" class="toast__label" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
