.topbar__group {
    flex-direction: row;
}

.topbar__group > .btn {
    margin-left: 24px;
}

.mode-selector {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 24px 40px 0 40px;
}

.btn--round {
    width: 128px;
    height: 136px;
    border-radius: 64px;
}

.btn--round > .btn__face {
    bottom: 12px;
    border-radius: 64px;
}

.btn--round:active > .btn__face {
    translate: 0 8px;
}

.btn--round .icon {
    width: 72px;
    height: 72px;
}

.mode-card {
    flex-grow: 1;
    align-items: center;
    margin: 0 24px;
    padding: 24px 24px 28px 24px;
    border-radius: 80px;
    border-bottom-width: 20px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.mode-card__art {
    width: 112px;
    height: 112px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
    scale: 1.3 1.3;
}

.mode-card__art--icon {
    scale: 1 1;
    border-radius: 56px;
    border-bottom-width: 10px;
    border-color: var(--color-coral-edge);
    background-color: var(--color-pingi);
}

.mode-card__art--icon .icon {
    width: 68px;
    height: 68px;
    -unity-background-image-tint-color: var(--color-on-accent);
}

.mode-card__name {
    margin-top: 8px;
    font-size: 80px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.mode-card__tagline {
    align-self: stretch;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.mode-card__best {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
    padding: 8px 28px;
    border-radius: 48px;
    background-color: var(--color-divider);
}

.mode-card__best .icon {
    width: 44px;
    height: 44px;
    margin-right: 10px;
    -unity-background-image-tint-color: var(--color-teal);
}

.mode-card__best-label {
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.mode-card--locked .mode-card__art {
    opacity: 0.4;
}

.mode-dots {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
    margin: 24px 0;
}

.mode-dot {
    width: 24px;
    height: 24px;
    margin: 0 8px;
    border-radius: 12px;
    background-color: var(--color-track-off);
}

.mode-dot--active {
    width: 64px;
    background-color: var(--color-ink);
}

.rush {
    flex-grow: 1;
    height: 176px;
    margin-right: 32px;
    justify-content: center;
}

.rush--hidden {
    visibility: hidden;
}

.rush-bar {
    height: 44px;
    overflow: hidden;
    border-radius: 22px;
    border-bottom-width: 8px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.rush-bar__fill {
    height: 100%;
    background-color: var(--color-sun);
}

.rush-bar__fill--low {
    background-color: var(--color-coral);
}

.rush-time {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.rush-time .icon {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.rush-time__label {
    color: var(--color-ink-muted);
    font-size: 44px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.hud-score {
    flex-grow: 0;
    margin-top: -224px;
}

.hud--timed .hud-score {
    margin-top: 0;
}

.combo {
    align-self: center;
    margin-top: 8px;
    padding: 10px 36px;
    border-radius: 40px;
    background-color: var(--color-chip-deep);
    color: var(--color-sun-bright);
    font-size: 44px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.combo--hidden {
    display: none;
}

.perfect {
    position: absolute;
    left: 0;
    right: 0;
    top: 58%;
    color: var(--color-coral-text);
    font-size: 88px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
    text-shadow: 0 8px 0 rgba(43, 45, 66, 0.12);
    rotate: -6deg;
    opacity: 0;
    scale: 0.6 0.6;
    translate: 0 0;
    transition-property: opacity, scale, translate;
    transition-duration: 220ms, 260ms, 420ms;
    transition-timing-function: ease-out, ease-out-back, ease-out-cubic;
}

.perfect--show {
    opacity: 1;
    scale: 1 1;
    translate: 0 -48px;
}

.banner-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    align-items: center;
}

.banner {
    padding: 14px 48px;
    border-radius: 48px;
    border-bottom-width: 10px;
    border-color: var(--color-chip-deep);
    background-color: var(--color-chip-deep);
    color: var(--color-sun-bright);
    font-size: 60px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 0.6 0.6;
    translate: 0 24px;
    transition-property: opacity, scale, translate;
    transition-duration: 200ms, 320ms, 320ms;
    transition-timing-function: ease-out, ease-out-back, ease-out-cubic;
}

.banner--record {
    border-color: var(--color-sun-edge);
    background-color: var(--color-sun);
    color: var(--color-on-sun);
}

.banner--show {
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.panel {
    flex-shrink: 0;
    margin: 32px 56px 0 56px;
    padding: 40px 48px;
    border-radius: 80px;
    border-bottom-width: 20px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.panel__head {
    flex-direction: row;
    align-items: center;
}

.panel__head .icon {
    width: 64px;
    height: 64px;
    margin-right: 16px;
    -unity-background-image-tint-color: var(--color-pingi);
}

.panel__title {
    font-size: 60px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    flex-shrink: 0;
    margin: 40px 56px 0 56px;
}

.stat {
    width: 48.5%;
    align-items: center;
    margin-bottom: 28px;
    padding: 36px 16px;
    border-radius: 64px;
    border-bottom-width: 16px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.stat__value {
    font-size: 88px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.stat__label {
    margin-top: 4px;
}

.record-row {
    flex-direction: row;
    align-items: center;
    height: 144px;
    border-top-width: 4px;
    border-color: var(--color-divider);
}

.record-row__name {
    flex-grow: 1;
    font-size: 56px;
}

.record-row__score {
    margin-right: 32px;
    font-size: 64px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.record-row__date {
    width: 200px;
    color: var(--color-ink-muted);
    font-size: 40px;
    -unity-text-align: middle-right;
}

.streak-days {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 32px;
}

.streak-day {
    width: 104px;
    height: 104px;
    align-items: center;
    justify-content: center;
    border-radius: 52px;
    background-color: var(--color-divider);
    -unity-background-scale-mode: scale-to-fit;
}

.streak-day--done {
    background-color: var(--color-coral);
}

.streak-day__label {
    color: var(--color-ink-muted);
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.streak-day--done .streak-day__label {
    color: var(--color-on-accent);
}

.streak-day--reward {
    background-color: var(--color-sun-tint);
}

.streak-note {
    margin-top: 20px;
    -unity-text-align: middle-right;
}

.mode-chips {
    flex-direction: row;
    flex-shrink: 0;
    margin: 32px 56px 0 56px;
}

.mode-chip {
    flex-grow: 1;
    height: 112px;
    margin: 0 8px;
    padding: 0;
    border-width: 0;
    border-bottom-width: 10px;
    border-radius: 56px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
    color: var(--color-ink-muted);
    font-size: 44px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.mode-chip--active {
    border-color: var(--color-teal-fill-edge);
    background-color: var(--color-teal-fill);
    color: var(--color-on-accent);
}

.empty {
    align-items: center;
    padding-top: 56px;
}

.world-best {
    margin-top: 28px;
    -unity-text-align: middle-center;
}

.empty__icon {
    width: 160px;
    height: 160px;
    margin-bottom: 16px;
    -unity-background-image-tint-color: var(--color-teal);
}

.dot--streak.dot--filled {
    background-color: var(--color-pingi);
}

.status--streak {
    background-color: var(--color-coral-tint);
}

.status--streak .item__status-label {
    color: var(--color-coral-text);
}

.status--streak .icon {
    -unity-background-image-tint-color: var(--color-coral-text);
}

.powers {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.power {
    flex-direction: row;
    align-items: center;
    margin: 0 8px;
    padding: 10px 18px;
    border-radius: 36px;
    background-color: var(--color-chip-deep);
}

.power--hidden {
    display: none;
}

.power .icon {
    width: 48px;
    height: 48px;
}

.power__track {
    width: 96px;
    height: 14px;
    margin-left: 12px;
    overflow: hidden;
    border-radius: 7px;
    background-color: var(--color-veil);
}

.power__fill {
    height: 100%;
    background-color: var(--color-sun);
}

.missions-button__count {
    position: absolute;
    top: -12px;
    right: -12px;
    padding: 4px 16px;
    border-radius: 28px;
    background-color: var(--color-coral);
    color: var(--color-on-accent);
    font-size: 36px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.missions-button__count--done {
    background-color: var(--color-teal-fill);
}

.missions-card {
    padding-left: 56px;
    padding-right: 56px;
}

.missions-list {
    align-self: stretch;
    margin-top: 32px;
}

.mission {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
    padding: 22px 28px;
    border-radius: 40px;
    background-color: var(--color-inset);
}

.mission--done {
    background-color: var(--color-teal-tint);
}

.mission__badge {
    flex-shrink: 0;
    width: 104px;
    height: 104px;
    align-items: center;
    justify-content: center;
    border-radius: 52px;
    background-color: var(--color-coral);
}

.mission--done .mission__badge {
    background-color: var(--color-teal-fill);
}

.mission__badge .icon {
    width: 60px;
    height: 60px;
}

.mission__body {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 20px 0 28px;
}

.mission__text {
    color: var(--color-ink);
    font-size: 42px;
    white-space: normal;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_semibold_sdf.asset");
}

.mission--done .mission__text {
    color: var(--color-teal-ink);
}

.mission__track {
    height: 24px;
    margin-top: 12px;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--color-track-off);
}

.mission__fill {
    width: 0;
    height: 100%;
    border-radius: 12px;
    background-color: var(--color-coral);
}

.mission--done .mission__fill {
    background-color: var(--color-teal-fill);
}

.mission__fill--reward {
    background-color: var(--color-sun);
}

.mission__count {
    min-width: 120px;
    color: var(--color-ink-muted);
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-right;
}

.mission--done .mission__count {
    color: var(--color-teal-ink);
}

.missions-reward {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-top: 32px;
    padding: 22px 28px;
    border-radius: 40px;
    border-width: 4px;
    border-color: var(--color-sun);
    background-color: var(--color-sun-tint);
}

.missions-reward .mission__text {
    color: var(--color-sun-ink);
}

.missions-reward__art {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    -unity-background-scale-mode: scale-to-fit;
}

.missions-stars {
    flex-direction: row;
    align-items: center;
    padding: 8px 24px;
    border-radius: 32px;
    background-color: var(--color-chip-deep);
}

.missions-stars .icon {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: var(--color-sun-bright);
}

.missions-stars__label {
    margin-left: 8px;
    color: var(--color-sun-bright);
    font-size: 44px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.thumb-rail {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 3%;
    height: 7%;
    align-items: center;
    justify-content: center;
    border-radius: 96px;
    background-color: var(--color-hint);
}

.thumb-rail__grip {
    width: 72px;
    height: 72px;
    -unity-background-image-tint-color: var(--color-hint-icon);
}

.event-card {
    flex-direction: row;
    align-items: center;
    align-self: center;
    width: 82%;
    margin-top: 16px;
    padding: 18px 28px 18px 18px;
    border-radius: 48px;
    background-color: var(--color-chip-deep);
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 200ms, 320ms;
    transition-timing-function: ease-out, ease-out-back;
}

.event-card--hidden {
    display: none;
    opacity: 0;
    scale: 0.8 0.8;
}

.event-card__badge {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    align-items: center;
    justify-content: center;
    border-radius: 48px;
    background-color: var(--color-coral);
}

.event-card__badge .icon {
    width: 56px;
    height: 56px;
}

.event-card__body {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 20px 0 24px;
}

.event-card__title {
    color: var(--color-sun-bright);
    font-size: 42px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.event-card__goal {
    color: var(--color-on-chip);
    font-size: 34px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.event-card__track {
    height: 14px;
    margin-top: 10px;
    overflow: hidden;
    border-radius: 7px;
    background-color: var(--color-veil);
}

.event-card__time {
    height: 100%;
    background-color: var(--color-sun);
}

.event-card__count {
    color: var(--color-sun-bright);
    font-size: 52px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.topbar--menu .btn--icon {
    width: 152px;
    height: 152px;
}

.topbar__group--left > .btn {
    margin-left: 0;
    margin-right: 24px;
}

.topbar--menu .level-chip {
    width: 168px;
}

.level-chip__face {
    padding: 0;
    flex-direction: column;
}

.level-chip__caption {
    margin: 0 0 -10px 0;
    color: var(--color-ink-muted);
    font-size: 28px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_semibold_sdf.asset");
}

.level-chip__number {
    margin: 0 0 2px 0;
    color: var(--color-coral-text);
    font-size: 60px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.level-chip__track {
    width: 112px;
    height: 14px;
    overflow: hidden;
    border-radius: 7px;
    background-color: var(--color-track-off);
}

.level-chip__fill {
    width: 0;
    height: 100%;
    border-radius: 7px;
    background-color: var(--color-sun);
}

.road-card {
    padding-left: 56px;
    padding-right: 56px;
}

.road-head {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-top: 32px;
    padding: 22px 28px;
    border-radius: 40px;
    border-width: 4px;
    border-color: var(--color-sun);
    background-color: var(--color-sun-tint);
}

.road-head .mission__text,
.road-head__xp {
    color: var(--color-sun-ink);
}

.road-head__xp {
    min-width: 0;
    font-size: 36px;
}

.road-badge {
    flex-shrink: 0;
    width: 112px;
    height: 112px;
    align-items: center;
    justify-content: center;
    border-radius: 56px;
    background-color: var(--color-coral);
}

.road-badge--small {
    width: 96px;
    height: 96px;
    border-radius: 48px;
}

.road-badge__number {
    color: var(--color-on-accent);
    font-size: 52px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.road-badge--small .road-badge__number {
    font-size: 44px;
}

.road-list {
    align-self: stretch;
    height: 700px;
    margin-top: 20px;
}

.road-step {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    padding: 16px 24px;
    border-radius: 36px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--color-inset);
}

.road-step--item {
    background-color: var(--color-sun-tint);
}

.road-step--next {
    border-color: var(--color-coral);
}

.road-step--done {
    opacity: 0.55;
}

.road-step__node {
    flex-shrink: 0;
    width: 84px;
    height: 84px;
    align-items: center;
    justify-content: center;
    border-radius: 42px;
    background-color: var(--color-track-off);
}

.road-step--done .road-step__node {
    background-color: var(--color-teal-fill);
}

.road-step--next .road-step__node {
    background-color: var(--color-coral);
}

.road-step__level {
    color: var(--color-ink-muted);
    font-size: 38px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.road-step--done .road-step__level,
.road-step--next .road-step__level {
    color: var(--color-on-accent);
}

.road-step__art {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    margin-left: 20px;
    align-items: center;
    justify-content: center;
    border-radius: 48px;
}

.road-step__art--coin {
    background-color: var(--color-sun);
}

.road-step__art--star {
    background-color: var(--color-coral);
}

.road-step__art .icon {
    width: 60px;
    height: 60px;
    -unity-background-image-tint-color: var(--color-on-accent);
}

.road-step__art--coin .icon {
    -unity-background-image-tint-color: var(--color-on-sun);
}

.road-step__picture {
    width: 96px;
    height: 96px;
    -unity-background-scale-mode: scale-to-fit;
}

.road-step__picture--paddle {
    width: 96px;
    height: 40px;
}

.road-step__swatch {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    border-width: 10px;
}

.road-step__body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 24px;
}

.road-step__text {
    color: var(--color-ink);
    font-size: 40px;
    white-space: normal;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_semibold_sdf.asset");
}

.road-step--item .road-step__text {
    color: var(--color-sun-ink);
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.road-step__extra {
    color: var(--color-ink-muted);
    font-size: 32px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.road-step__state {
    width: 56px;
    height: 56px;
    -unity-background-image-tint-color: var(--color-teal-ink);
}

.xp-row {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-top: 24px;
    padding: 16px 24px;
    border-radius: 40px;
    background-color: var(--color-inset);
}

.xp-row--up {
    background-color: var(--color-sun-tint);
}

.xp-row__text {
    font-size: 38px;
}

.xp-row--up .xp-row__text {
    color: var(--color-sun-ink);
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.adv-world {
    flex-direction: row;
    align-items: center;
    margin: 24px 56px 0 56px;
    padding: 24px 32px;
    border-radius: 48px;
    border-bottom-width: 10px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.adv-world__badge {
    flex-shrink: 0;
    width: 128px;
    height: 128px;
    align-items: center;
    justify-content: center;
    border-radius: 64px;
}

.adv-world__badge .icon {
    width: 76px;
    height: 76px;
}

.adv-world__body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 28px;
}

.adv-world__name {
    color: var(--color-ink);
    font-size: 52px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.adv-world__note {
    color: var(--color-ink-muted);
    font-size: 36px;
    white-space: normal;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.adv-world__stars {
    padding: 8px 24px;
    border-radius: 32px;
    background-color: var(--color-sun-tint);
    color: var(--color-sun-ink);
    font-size: 44px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.adv-path {
    margin: 24px 56px 0 56px;
}

.adv-row {
    height: 252px;
}

.adv-node {
    position: absolute;
    top: 14px;
    width: 176px;
    height: 176px;
    margin: 0 0 0 -88px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-bottom-width: 14px;
    border-radius: 88px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.adv-node:active {
    translate: 0 6px;
}

.adv-node--next {
    border-color: var(--color-coral-edge);
    background-color: var(--color-coral);
}

.adv-node--locked {
    background-color: var(--color-track-off);
}

.adv-node--boss {
    top: 0;
    width: 208px;
    height: 208px;
    margin-left: -104px;
    border-radius: 104px;
}

.adv-node__face {
    align-items: center;
    justify-content: center;
}

.adv-node__number {
    color: var(--color-ink);
    font-size: 72px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.adv-node--done .adv-node__number,
.adv-node--next .adv-node__number {
    color: var(--color-on-accent);
}

.adv-node__lock {
    width: 72px;
    height: 72px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.adv-node__crown {
    width: 56px;
    height: 56px;
    margin-bottom: -14px;
    -unity-background-image-tint-color: var(--color-sun-ink);
}

.adv-node--done .adv-node__crown,
.adv-node--next .adv-node__crown {
    -unity-background-image-tint-color: var(--color-on-accent);
}

.adv-node__stars {
    position: absolute;
    bottom: -48px;
    flex-direction: row;
}

.adv-node__star {
    width: 44px;
    height: 44px;
    margin: 0 2px;
    -unity-background-image-tint-color: var(--color-track-off);
}

.adv-node__star--on {
    -unity-background-image-tint-color: var(--color-sun);
}

.adv-dialog {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.adv-dialog--hidden {
    display: none;
}

.adv-card {
    padding-top: 160px;
}

.adv-card__badge {
    position: absolute;
    top: -128px;
    left: 50%;
    width: 256px;
    height: 256px;
    margin-left: -128px;
    align-items: center;
    justify-content: center;
    border-radius: 128px;
    border-width: 12px;
    border-color: var(--color-surface);
}

.adv-card__badge .icon {
    width: 132px;
    height: 132px;
}

.adv-card__goal {
    margin-top: 12px;
    color: var(--color-ink);
    font-size: 48px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_semibold_sdf.asset");
}

.adv-tags {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 16px;
}

.adv-tag {
    flex-direction: row;
    align-items: center;
    margin: 8px;
    padding: 10px 24px 10px 16px;
    border-radius: 36px;
    background-color: var(--color-inset);
}

.adv-tag .icon {
    width: 48px;
    height: 48px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.adv-tag__label {
    margin-left: 8px;
    color: var(--color-ink-muted);
    font-size: 34px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_semibold_sdf.asset");
}

.adv-stars {
    flex-direction: row;
    justify-content: center;
    margin-top: 24px;
}

.adv-star {
    width: 88px;
    height: 88px;
    margin: 0 8px;
    -unity-background-image-tint-color: var(--color-track-off);
    transition-property: scale;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}

.adv-star--on {
    -unity-background-image-tint-color: var(--color-sun);
}

.adv-stars--big .adv-star {
    width: 136px;
    height: 136px;
    margin: 0 12px;
    scale: 0.7 0.7;
}

.adv-stars--big .adv-star--on {
    scale: 1 1;
}

.adv-card__note {
    margin-top: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.adv-card__reward {
    margin-top: 16px;
    color: var(--color-sun-ink);
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.adv-result__gold {
    justify-content: center;
}

.btn.adv-result__side {
    width: 168px;
}

.adv-result__retry {
    margin-left: 24px;
}
