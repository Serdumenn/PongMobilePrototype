.icon--person-add { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_person_add.svg"); }
.icon--close { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_close.svg"); }
.icon--more { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_more.svg"); }

.friend-code {
    margin-top: 12px;
    font-size: 84px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.friend-add {
    flex-shrink: 0;
    margin-top: 40px;
}

.friends-section {
    margin-top: 40px;
    margin-bottom: 0;
}

.friends-count {
    min-width: 72px;
    padding: 6px 22px;
    border-radius: 40px;
    background-color: var(--color-divider);
    color: var(--color-ink-muted);
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.friend-list {
    margin-top: 16px;
}

.friends-empty {
    margin-top: 20px;
}

.friend-row {
    flex-direction: row;
    align-items: center;
    min-height: 136px;
    border-top-width: 4px;
    border-color: var(--color-divider);
}

.friend-row--first {
    border-top-width: 0;
}

.friend-dot {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 14px;
    background-color: var(--color-track-off);
}

.friend-dot--online {
    background-color: var(--color-teal);
}

.friend-dot--playing {
    background-color: var(--color-sun);
}

.friend-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 16px 0 24px;
}

.friend-row__text--plain {
    margin-left: 0;
}

.friend-row__name {
    font-size: 50px;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.friend-row__status {
    color: var(--color-ink-muted);
    font-size: 36px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.friend-invite {
    width: 232px;
    height: 112px;
    flex-shrink: 0;
    margin-right: 12px;
    border-radius: 56px;
    background-color: var(--color-teal-edge);
}

.friend-invite > .btn__face {
    bottom: 12px;
    padding: 0 24px;
    border-radius: 56px;
    background-color: var(--color-teal);
}

.friend-invite:active > .btn__face {
    translate: 0 8px;
}

.friend-invite .btn__label {
    margin-left: 0;
    font-size: 44px;
}

.friend-icon-btn {
    width: 112px;
    height: 112px;
    flex-shrink: 0;
    margin-left: 12px;
    border-radius: 56px;
}

.friend-icon-btn > .btn__face {
    bottom: 10px;
    padding: 0;
    border-radius: 56px;
}

.friend-icon-btn:active > .btn__face {
    translate: 0 8px;
}

.friend-icon-btn .icon {
    width: 56px;
    height: 56px;
}

.friend-icon-btn--plain > .btn__face {
    border-width: 4px;
    border-color: var(--color-divider);
}

.friend-icon-btn--plain .icon {
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.friend-icon-btn--yes {
    background-color: var(--color-teal-edge);
}

.friend-icon-btn--yes > .btn__face {
    background-color: var(--color-teal);
}

.friend-field > .unity-base-text-field__input,
.friend-field.unity-base-text-field:hover:enabled > .unity-base-text-field__input {
    height: 176px;
    font-size: 64px;
    letter-spacing: 0;
}

.friend-paste {
    margin-top: 20px;
}

.friend-menu__button {
    height: 176px;
    margin-top: 32px;
}

.friend-menu__button > .btn__face {
    bottom: 18px;
    border-width: 4px;
    border-color: var(--color-divider);
}

.friend-menu__button:active > .btn__face {
    translate: 0 14px;
}

.friend-menu__button .icon {
    width: 64px;
    height: 64px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.friend-menu__button .btn__label {
    margin-left: 20px;
    color: var(--color-ink);
    font-size: 52px;
}

.friend-menu__button--danger .icon {
    -unity-background-image-tint-color: var(--color-coral);
}

.friend-menu__button--danger .btn__label {
    color: var(--color-coral);
}

.friends-entry {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 176px;
    margin: 0;
    padding: 0 32px 12px 36px;
    border-width: 0;
    border-bottom-width: 16px;
    border-radius: 64px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.friends-entry:active {
    border-color: var(--color-teal);
}

.friends-entry:disabled {
    opacity: 0.5;
}

.friends-entry__icon {
    width: 80px;
    height: 80px;
    -unity-background-image-tint-color: var(--color-teal-edge);
}

.friends-entry__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 16px 0 28px;
}

.friends-entry__title {
    font-size: 54px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.friends-entry__sub {
    color: var(--color-ink-muted);
    font-size: 38px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.friends-badge {
    min-width: 64px;
    height: 64px;
    margin-right: 12px;
    padding: 0 16px;
    border-radius: 32px;
    background-color: var(--color-coral);
    color: #FFFFFF;
    font-size: 38px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.friends-entry__chevron {
    width: 56px;
    height: 56px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.lobby-invite {
    margin-top: 20px;
}

.result-friend {
    margin-top: 8px;
}

.rank-row__friend {
    width: 96px;
    height: 96px;
    margin-left: 16px;
}

.rank-row__friend > .btn__face {
    border-radius: 48px;
}

.rank-row__friend .icon {
    width: 48px;
    height: 48px;
}

.rank-row__friend-done {
    width: 48px;
    height: 48px;
    margin-left: 32px;
    margin-right: 24px;
    -unity-background-image-tint-color: var(--color-teal-edge);
}

.world-find {
    margin-top: 8px;
}

.invite-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 32px;
    align-items: center;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 200ms, 260ms;
    transition-timing-function: ease-out, ease-out-back;
}

.invite-banner--hidden {
    opacity: 0;
    translate: 0 -40px;
}

.invite-banner__card {
    flex-direction: row;
    align-items: center;
    width: 92%;
    max-width: 968px;
    padding: 20px 20px 24px 32px;
    border-width: 6px;
    border-bottom-width: 16px;
    border-radius: 64px;
    border-color: var(--color-teal);
    background-color: var(--color-surface);
}

.invite-banner__icon {
    width: 72px;
    height: 72px;
    -unity-background-image-tint-color: var(--color-teal-edge);
}

.invite-banner__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 16px 0 24px;
}

.invite-banner__title {
    font-size: 44px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.invite-banner__sub {
    color: var(--color-ink-muted);
    font-size: 36px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.invite-banner__join {
    flex-grow: 0;
    width: 220px;
    height: 128px;
    margin-left: 0;
}

.invite-banner__join > .btn__face {
    bottom: 14px;
    padding: 0 20px;
}

.invite-banner__join:active > .btn__face {
    translate: 0 10px;
}

.invite-banner__join .btn__label {
    margin-left: 0;
    font-size: 48px;
}

.invite-banner__close {
    width: 96px;
    height: 96px;
    margin-left: 12px;
    border-radius: 48px;
    background-color: rgba(0, 0, 0, 0);
}

.invite-banner__close > .btn__face {
    bottom: 0;
    padding: 0;
    border-radius: 48px;
    background-color: rgba(0, 0, 0, 0);
}

.invite-banner__close .icon {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}
