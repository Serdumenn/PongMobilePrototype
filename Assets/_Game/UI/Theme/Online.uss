.icon--bolt { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_bolt.svg"); }
.icon--share { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_share.svg"); }
.icon--copy { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_copy.svg"); }
.icon--join { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_join.svg"); }
.icon--wifi { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_wifi.svg"); }
.icon--wifi-off { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_wifi_off.svg"); }

.online-scroll {
    flex-grow: 1;
}

.online-gap {
    height: 32px;
    flex-shrink: 0;
}

.online-end {
    height: 72px;
    flex-shrink: 0;
}

.me-card {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 208px;
    padding: 0 28px 16px 36px;
    border-radius: 64px;
    border-bottom-width: 16px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.me-card__ball {
    width: 144px;
    height: 144px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.me-card__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 32px;
}

.me-card__caption {
    color: var(--color-ink-muted);
    font-size: 38px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.me-card__name {
    font-size: 60px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.me-card__look {
    width: 128px;
    height: 136px;
    border-radius: 44px;
}

.me-card__look > .btn__face {
    bottom: 10px;
    border-radius: 44px;
    border-width: 4px;
    border-color: var(--color-divider);
}

.me-card__look:active > .btn__face {
    translate: 0 8px;
}

.me-card__look .icon {
    width: 64px;
    height: 64px;
}

.online-quick {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 0;
    align-self: stretch;
}

.online-quick .icon {
    width: 80px;
    height: 80px;
}

.online-pair {
    flex-direction: row;
    flex-shrink: 0;
}

.online-pair > .btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 176px;
}

.online-pair > .btn > .btn__face {
    bottom: 18px;
    border-width: 4px;
    border-color: var(--color-divider);
}

.online-pair > .btn:active > .btn__face {
    translate: 0 14px;
}

.online-pair > .btn .btn__label {
    margin-left: 18px;
    color: var(--color-ink);
    font-size: 52px;
}

.online-pair > .btn .icon {
    width: 64px;
    height: 64px;
}

.online-pair__gap {
    width: 32px;
    flex-shrink: 0;
}

.online-modes {
    flex-shrink: 0;
    padding: 12px 44px 28px 44px;
    border-radius: 64px;
    border-bottom-width: 16px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.online-mode {
    flex-direction: row;
    align-items: center;
    height: 172px;
    margin: 0;
    padding: 0 20px;
    border-width: 0;
    border-radius: 40px;
    background-color: rgba(0, 0, 0, 0);
}

.online-mode--selected {
    background-color: var(--color-select);
}

.online-mode-divider {
    height: 4px;
    margin: 0 20px;
    flex-shrink: 0;
    background-color: var(--color-divider);
}

.online-mode__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.online-mode__name {
    font-size: 50px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.online-mode__sub {
    color: var(--color-ink-muted);
    font-size: 36px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.online-mode--soon .online-mode__name,
.online-mode--soon .online-mode__sub {
    opacity: 0.45;
}

.online-mode__pick {
    width: 56px;
    height: 56px;
    margin-right: 24px;
    border-radius: 28px;
    border-width: 6px;
    border-color: var(--color-track-off);
}

.online-mode--selected .online-mode__pick {
    border-width: 18px;
    border-color: var(--color-teal);
}

.online-mode--soon .online-mode__pick {
    opacity: 0;
}

.soon-chip {
    flex-shrink: 0;
    padding: 10px 28px;
    border-radius: 40px;
    background-color: var(--color-divider);
    color: var(--color-ink-muted);
    font-size: 36px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.online-status {
    align-items: center;
    padding: 72px 64px;
    border-radius: 72px;
    border-bottom-width: 20px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.online-status .icon {
    width: 144px;
    height: 144px;
    -unity-background-image-tint-color: var(--color-teal);
}

.online-status__retry {
    flex-grow: 0;
    width: 560px;
    height: 176px;
    margin: 48px 0 0 0;
}

.online-status__retry .btn__label {
    margin-left: 0;
}

.online-card {
    padding-top: 80px;
}

.code-field {
    align-self: stretch;
    margin: 48px 0 0 0;
    --unity-selection-color: rgba(46, 196, 182, 0.3);
    --unity-cursor-color: #2B2D42;
}

.code-field > .unity-base-text-field__input,
.code-field.unity-base-text-field:hover:enabled > .unity-base-text-field__input {
    height: 224px;
    padding: 0 24px;
    border-width: 6px;
    border-radius: 56px;
    border-color: var(--color-divider);
    background-color: var(--color-field);
    color: var(--color-ink);
    font-size: 128px;
    letter-spacing: 18px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.code-field.unity-base-text-field:focus:enabled > .unity-base-text-field__input {
    border-color: var(--color-teal);
}

.lobby-body {
    flex-grow: 1;
    margin: 40px 56px 0 56px;
}

.code-card {
    align-items: center;
    flex-shrink: 0;
    padding: 56px 56px 48px 56px;
    border-radius: 72px;
    border-bottom-width: 20px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.code-card__code {
    margin-top: 8px;
    font-size: 150px;
    letter-spacing: 22px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.code-card .online-pair {
    align-self: stretch;
    margin-top: 32px;
}

.code-card__expiry {
    flex-direction: row;
    align-items: center;
    margin-top: 28px;
}

.code-card__expiry .icon {
    width: 48px;
    height: 48px;
    margin-right: 12px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.code-card__expiry-label {
    color: var(--color-ink-muted);
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.lobby-slots {
    flex-shrink: 0;
    margin-top: 56px;
}

.slot {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 232px;
    margin-bottom: 32px;
    padding: 0 36px 14px 36px;
    border-radius: 64px;
    border-bottom-width: 14px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.slot--waiting {
    padding-bottom: 0;
    border-width: 6px;
    border-color: var(--color-card-edge);
    background-color: var(--color-veil);
}

.slot__ball {
    width: 160px;
    height: 160px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.slot__dots {
    width: 160px;
    flex-shrink: 0;
    color: var(--color-card-edge);
    font-size: 80px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.slot__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 36px;
}

.slot__name {
    font-size: 58px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.slot__sub {
    color: var(--color-ink-muted);
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.ready-mark {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 48px;
    background-color: var(--color-track-off);
}

.ready-mark .icon {
    width: 60px;
    height: 60px;
    -unity-background-image-tint-color: var(--color-on-accent);
}

.ready-mark--on {
    background-color: var(--color-teal-fill);
}

.versus {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.pcard {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    height: 500px;
    padding: 48px 24px 0 24px;
    border-radius: 64px;
    border-top-width: 18px;
    border-bottom-width: 14px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.pcard--p0 { border-top-color: var(--color-player-0); }
.pcard--p1 { border-top-color: var(--color-player-1); }

.pcard__ball {
    width: 230px;
    height: 230px;
    -unity-background-scale-mode: scale-to-fit;
}

.pcard__name {
    margin-top: 20px;
    font-size: 50px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.pcard__sub {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
}

.pcard__sub .icon {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--color-teal-ink);
}

.pcard__sub-label {
    color: var(--color-ink-muted);
    font-size: 38px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.pcard .ready-mark {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 80px;
    height: 80px;
    border-radius: 40px;
}

.pcard .ready-mark .icon {
    width: 50px;
    height: 50px;
}

.versus__label {
    width: 112px;
    flex-shrink: 0;
    color: var(--color-ink-muted);
    font-size: 64px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.lobby-center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.lobby-status {
    align-self: stretch;
    flex-shrink: 0;
    white-space: normal;
}

.lobby-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 56px 64px 56px;
}

.lobby-footer > .ink-chip {
    flex-shrink: 1;
}

.lobby-ready {
    flex-grow: 1;
    height: 192px;
    margin-left: 32px;
    background-color: var(--color-teal-fill-edge);
}

.lobby-ready > .btn__face {
    bottom: 18px;
    background-color: var(--color-teal-fill);
}

.lobby-ready:active > .btn__face {
    translate: 0 14px;
}

.lobby-ready .btn__label {
    font-size: 64px;
}

.lobby-ready .icon {
    width: 72px;
    height: 72px;
}

.lobby-ready--on {
    background-color: var(--color-surface-edge);
}

.lobby-ready--on > .btn__face {
    background-color: var(--color-surface);
    border-width: 4px;
    border-color: var(--color-divider);
}

.lobby-ready--on .btn__label {
    color: var(--color-ink);
}

.reconnect-ring {
    width: 240px;
    height: 240px;
    align-items: center;
    justify-content: center;
    border-width: 16px;
    border-radius: 120px;
    border-color: var(--color-teal);
}

.reconnect-ring__count {
    font-size: 104px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.reconnect-title {
    margin-top: 36px;
}

.icon--thumb { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_thumb.svg"); }
.icon--wow { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_wow.svg"); }
.icon--laugh { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_laugh.svg"); }

.ohud-top {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 32px 56px 0 56px;
}

.opp-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    height: 176px;
    margin-right: 24px;
    padding: 0 36px 12px 24px;
    border-radius: 64px;
    border-bottom-width: 12px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.opp-card__ball {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.opp-card__name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 24px;
    font-size: 50px;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.opp-card__score {
    margin: 0 20px;
    font-size: 88px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.opp-card__lives {
    flex-direction: row;
    margin-right: 16px;
}

.opp-card__wifi {
    width: 56px;
    height: 56px;
    -unity-background-image-tint-color: var(--color-teal-ink);
}

.opp-card__wifi--weak {
    -unity-background-image-tint-color: var(--color-coral-text);
}

.ohud-menu {
    width: 160px;
    height: 168px;
    border-radius: 48px;
}

.ohud-menu > .btn__face {
    bottom: 12px;
    border-radius: 48px;
}

.ohud-menu .icon {
    width: 72px;
    height: 72px;
}

.portal-chip {
    align-self: center;
    margin-top: 72px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 400ms;
}

.portal-chip--hidden {
    opacity: 0;
}

.ohud-center {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.ohud-score {
    color: var(--color-watermark);
    font-size: 360px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
    scale: 1 1;
    transition-property: scale;
    transition-duration: 320ms;
    transition-timing-function: ease-out-back;
}

.ohud-score--pop {
    scale: 1.2 1.2;
    transition-duration: 60ms;
}

.ohud-count {
    position: absolute;
    color: var(--color-coral-text);
    font-size: 400px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.ohud-serve {
    position: absolute;
    bottom: 34%;
}

.ohud-bottom {
    flex-direction: row;
    align-items: center;
    align-self: flex-end;
    flex-shrink: 0;
    margin: 0 56px 48px 0;
}

.reaction-bar {
    flex-direction: row;
    margin-right: 20px;
    padding: 12px;
    border-radius: 80px;
    background-color: var(--color-float);
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 180ms;
}

.reaction-bar--hidden {
    opacity: 0;
    translate: 40px 0;
}

.reaction-btn {
    width: 136px;
    height: 144px;
    margin: 0 6px;
    border-radius: 68px;
}

.reaction-btn > .btn__face {
    bottom: 10px;
    border-radius: 68px;
}

.reaction-btn .icon {
    width: 72px;
    height: 72px;
}

.reaction-toggle {
    width: 152px;
    height: 160px;
    border-radius: 76px;
}

.reaction-toggle > .btn__face {
    bottom: 12px;
    border-radius: 76px;
}

.reaction-toggle .icon {
    width: 80px;
    height: 80px;
}

.float-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.reaction-float {
    position: absolute;
    width: 150px;
    height: 150px;
    align-items: center;
    justify-content: center;
    border-radius: 75px;
    border-bottom-width: 10px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
    transition-property: translate, opacity, scale;
    transition-duration: 1500ms, 1500ms, 220ms;
    transition-timing-function: ease-out-cubic, ease-in-cubic, ease-out-back;
}

.reaction-float .icon {
    width: 92px;
    height: 92px;
}

.reaction-float--start {
    scale: 0.4 0.4;
}

.reaction-float--gone {
    opacity: 0;
}

.result-score {
    margin-top: -16px;
    color: var(--color-coral-text);
    font-size: 200px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.rematch-note {
    margin-top: 8px;
    white-space: normal;
    align-self: stretch;
}

.icon--mini-paddle { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_mini_paddle.svg"); }
.icon--fast-ball { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_fast_ball.svg"); }
.icon--fog { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_fog.svg"); }
.icon--shield { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_shield.svg"); }

.fog {
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    height: 42%;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 350ms;
}

.fog--hidden {
    opacity: 0;
}

.fog__band {
    flex-grow: 2;
    background-color: var(--color-fog);
}

.fog__band--soft {
    flex-grow: 1;
    background-color: var(--color-fog-soft);
}

.rivals {
    position: absolute;
    right: 56px;
    top: 36%;
    width: 470px;
    padding: 12px 28px 20px 28px;
    border-radius: 48px;
    border-bottom-width: 12px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.rival {
    flex-direction: row;
    align-items: center;
    height: 92px;
}

.rival__ball {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.rival__name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 18px;
    font-size: 40px;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.rival__score {
    margin-left: 12px;
    font-size: 50px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.rival--leader .rival__score {
    color: var(--color-coral-text);
}

.rival--done .rival__name,
.rival--done .rival__ball {
    opacity: 0.55;
}

.rival--left {
    opacity: 0.35;
}

.attack-banner {
    position: absolute;
    left: 56px;
    right: 56px;
    top: 56%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 24px 40px;
    border-radius: 64px;
    border-bottom-width: 14px;
    border-color: var(--color-sun-edge);
    background-color: var(--color-sun);
    scale: 1 1;
    opacity: 1;
    transition-property: scale, opacity;
    transition-duration: 260ms, 180ms;
    transition-timing-function: ease-out-back, ease-out;
    color: var(--color-on-sun);
}

.attack-banner--hidden {
    scale: 0.85 0.85;
    opacity: 0;
}

.attack-banner .icon {
    width: 64px;
    height: 64px;
    margin-right: 20px;
}

.attack-banner__label {
    flex-shrink: 1;
    font-size: 44px;
    white-space: normal;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.rush-note {
    position: absolute;
    top: 66%;
    align-self: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 250ms;
}

.rush-note--hidden {
    opacity: 0;
}

.rush-wait {
    position: absolute;
    top: 26%;
    align-self: center;
}

.rank-list {
    align-self: stretch;
    margin-top: 32px;
}

.rank-row {
    flex-direction: row;
    align-items: center;
    height: 120px;
    padding: 0 24px;
    border-radius: 40px;
}

.rank-row--me {
    background-color: var(--color-select);
}

.rank-row--left {
    opacity: 0.4;
}

.rank-row__place {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    border-radius: 36px;
    background-color: var(--color-divider);
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.rank-row__place--gold {
    background-color: var(--color-sun);
    color: var(--color-on-sun);
}

.rank-row__ball {
    width: 76px;
    height: 76px;
    margin-left: 20px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.rank-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 20px;
    font-size: 46px;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.rank-row__score {
    font-size: 58px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.rush-result-card {
    padding-top: 150px;
}

.icon--calendar { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_calendar.svg"); }
.icon--ghost { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_ghost.svg"); }

.challenge-card {
    flex-shrink: 0;
    margin-bottom: 44px;
    padding: 44px 44px 52px 44px;
    border-radius: 64px;
    border-bottom-width: 16px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.challenge-card__head {
    flex-direction: row;
    align-items: center;
}

.challenge-card__head .icon {
    width: 64px;
    height: 64px;
    margin-right: 20px;
}

.challenge-card__title {
    flex-grow: 1;
    font-size: 58px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.date-chip {
    padding: 8px 28px;
    border-radius: 40px;
    background-color: var(--color-sun-tint);
    color: var(--color-sun-ink);
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.challenge-card__text {
    margin-top: 16px;
    color: var(--color-ink-muted);
    font-size: 40px;
    white-space: normal;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.daily-stats {
    flex-direction: row;
    margin-top: 32px;
    padding: 20px 12px;
    border-radius: 40px;
    background-color: var(--color-inset);
}

.daily-stat {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
}

.daily-stat__label {
    color: var(--color-ink-muted);
    font-size: 34px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.daily-stat__value {
    font-size: 60px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.daily-play {
    flex-grow: 0;
    align-self: stretch;
    margin: 36px 0 0 0;
}

.daily-play .icon {
    width: 80px;
    height: 80px;
}

.challenge-card--soon .challenge-card__title,
.challenge-card--soon .challenge-card__text,
.challenge-card--soon .icon {
    opacity: 0.5;
}

.world-board {
    flex-shrink: 0;
    margin: 32px 56px 0 56px;
    padding: 20px 28px 28px 28px;
    border-radius: 64px;
    border-bottom-width: 16px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.world-board__note {
    margin: 24px 0;
    white-space: normal;
}

.world-gap {
    align-self: center;
    margin: 4px 0;
    color: var(--color-ink-muted);
    font-size: 40px;
}

.ghost-enter {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    height: 160px;
    margin: 32px 0 0 0;
    padding: 0 40px;
    border-width: 6px;
    border-radius: 48px;
    border-color: var(--color-divider);
    background-color: var(--color-field);
}

.ghost-enter:active {
    border-color: var(--color-teal);
}

.ghost-enter:disabled {
    opacity: 0.5;
}

.ghost-enter__label {
    flex-grow: 1;
    color: var(--color-ink-muted);
    font-size: 52px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_semibold_sdf.asset");
}

.ghost-enter__icon {
    width: 64px;
    height: 64px;
    -unity-background-image-tint-color: var(--color-teal-text);
}

.ghost-share {
    flex-direction: row;
    align-items: center;
    align-self: center;
    margin: 28px 0 0 0;
    padding: 12px 16px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ghost-share:disabled {
    opacity: 1;
}

.ghost-share__icon {
    width: 56px;
    height: 56px;
    margin-right: 16px;
    -unity-background-image-tint-color: var(--color-teal-text);
}

.ghost-share__label {
    color: var(--color-teal-text);
    font-size: 46px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.ghost-share--off .ghost-share__icon {
    -unity-background-image-tint-color: var(--color-ink-muted);
    opacity: 0.5;
}

.ghost-share--off .ghost-share__label {
    color: var(--color-ink-muted);
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.ghost-card {
    position: absolute;
    right: 56px;
    top: 36%;
    width: 470px;
    flex-direction: row;
    align-items: center;
    padding: 20px 28px 24px 24px;
    border-radius: 48px;
    border-bottom-width: 12px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.ghost-card__ball {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    opacity: 0.55;
    -unity-background-scale-mode: scale-to-fit;
}

.ghost-card__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 18px;
    overflow: hidden;
}

.ghost-card__name {
    font-size: 40px;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.ghost-card__tag {
    flex-direction: row;
    align-items: center;
}

.ghost-card__tag .icon {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.ghost-card__tag-label {
    color: var(--color-ink-muted);
    font-size: 32px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.ghost-card__score {
    flex-shrink: 0;
    margin-left: 16px;
    font-size: 56px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.ghost-card--ahead .ghost-card__score {
    color: var(--color-coral-text);
}

.ghost-delta {
    align-self: center;
    margin-top: 8px;
    padding: 10px 36px;
    border-radius: 40px;
    background-color: var(--color-chip);
    color: var(--color-on-chip);
    font-size: 44px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.ghost-delta--ahead {
    background-color: var(--color-teal-fill);
    color: var(--color-on-accent);
}

.ghost-delta--behind {
    background-color: var(--color-coral);
    color: var(--color-on-accent);
}

.ghost-delta--hidden {
    display: none;
}

.ghost-result-card {
    padding-top: 150px;
}

.ghost-vs {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-top: 24px;
}

.ghost-vs__side {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    overflow: hidden;
}

.ghost-vs__score {
    color: var(--color-ink-muted);
    font-size: 128px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.ghost-vs__score--me {
    color: var(--color-coral-text);
}

.ghost-vs__vs {
    margin: 0 20px;
    color: var(--color-ink-muted);
    font-size: 48px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.ghost-vs__who {
    flex-direction: row;
    align-items: center;
    max-width: 100%;
}

.ghost-vs__who .icon {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.ghost-vs__name {
    flex-shrink: 1;
    color: var(--color-ink);
    font-size: 40px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_semibold_sdf.asset");
}

.ghost-spark {
    align-self: stretch;
    height: 200px;
    margin-top: 24px;
    padding: 16px 12px;
    border-radius: 40px;
    background-color: var(--color-inset);
}

.ghost-result-actions {
    margin-top: 32px;
}

.ghost-retry {
    flex-grow: 1;
    height: 208px;
    margin-left: 32px;
}

.ghost-retry > .btn__face {
    bottom: 20px;
    border-width: 6px;
    border-color: var(--color-divider);
}

.ghost-retry:active > .btn__face {
    translate: 0 16px;
}

.ghost-retry .btn__label {
    color: var(--color-ink);
}

.ghost-code-card {
    padding-top: 64px;
}

.ghost-code-card__icon {
    width: 104px;
    height: 104px;
    margin-bottom: 16px;
}

.ghost-code-card__code {
    margin-top: 24px;
    color: var(--color-ink);
}

.ghost-code-card__pair {
    align-self: stretch;
    margin-top: 40px;
}
