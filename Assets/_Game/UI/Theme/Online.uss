.icon--bolt { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_bolt.svg"); }
.icon--share { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_share.svg"); }
.icon--copy { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_copy.svg"); }
.icon--join { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_join.svg"); }
.icon--wifi { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_wifi.svg"); }
.icon--wifi-off { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_wifi_off.svg"); }

.online-scroll {
    flex-grow: 1;
}

.online-gap {
    height: 32px;
    flex-shrink: 0;
}

.online-end {
    height: 72px;
    flex-shrink: 0;
}

.me-card {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 208px;
    padding: 0 28px 16px 36px;
    border-radius: 64px;
    border-bottom-width: 16px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.me-card__ball {
    width: 144px;
    height: 144px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.me-card__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 32px;
}

.me-card__caption {
    color: var(--color-ink-muted);
    font-size: 38px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.me-card__name {
    font-size: 60px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.me-card__look {
    width: 128px;
    height: 136px;
    border-radius: 44px;
}

.me-card__look > .btn__face {
    bottom: 10px;
    border-radius: 44px;
    border-width: 4px;
    border-color: var(--color-divider);
}

.me-card__look:active > .btn__face {
    translate: 0 8px;
}

.me-card__look .icon {
    width: 64px;
    height: 64px;
}

.online-quick {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 0;
    align-self: stretch;
}

.online-quick .icon {
    width: 80px;
    height: 80px;
}

.online-pair {
    flex-direction: row;
    flex-shrink: 0;
}

.online-pair > .btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 176px;
}

.online-pair > .btn > .btn__face {
    bottom: 18px;
    border-width: 4px;
    border-color: var(--color-divider);
}

.online-pair > .btn:active > .btn__face {
    translate: 0 14px;
}

.online-pair > .btn .btn__label {
    margin-left: 18px;
    color: var(--color-ink);
    font-size: 52px;
}

.online-pair > .btn .icon {
    width: 64px;
    height: 64px;
}

.online-pair__gap {
    width: 32px;
    flex-shrink: 0;
}

.online-modes {
    flex-shrink: 0;
    padding: 12px 44px 28px 44px;
    border-radius: 64px;
    border-bottom-width: 16px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.online-mode {
    flex-direction: row;
    align-items: center;
    height: 172px;
    margin: 0;
    padding: 0 20px;
    border-width: 0;
    border-radius: 40px;
    background-color: rgba(0, 0, 0, 0);
}

.online-mode--selected {
    background-color: #E6F7F5;
}

.online-mode-divider {
    height: 4px;
    margin: 0 20px;
    flex-shrink: 0;
    background-color: var(--color-divider);
}

.online-mode__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.online-mode__name {
    font-size: 50px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.online-mode__sub {
    color: var(--color-ink-muted);
    font-size: 36px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.online-mode--soon .online-mode__name,
.online-mode--soon .online-mode__sub {
    opacity: 0.45;
}

.online-mode__pick {
    width: 56px;
    height: 56px;
    margin-right: 24px;
    border-radius: 28px;
    border-width: 6px;
    border-color: var(--color-track-off);
}

.online-mode--selected .online-mode__pick {
    border-width: 18px;
    border-color: var(--color-teal);
}

.online-mode--soon .online-mode__pick {
    opacity: 0;
}

.soon-chip {
    flex-shrink: 0;
    padding: 10px 28px;
    border-radius: 40px;
    background-color: var(--color-divider);
    color: var(--color-ink-muted);
    font-size: 36px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.online-status {
    align-items: center;
    padding: 72px 64px;
    border-radius: 72px;
    border-bottom-width: 20px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.online-status .icon {
    width: 144px;
    height: 144px;
    -unity-background-image-tint-color: var(--color-teal);
}

.online-status__retry {
    flex-grow: 0;
    width: 560px;
    height: 176px;
    margin: 48px 0 0 0;
}

.online-status__retry .btn__label {
    margin-left: 0;
}

.online-card {
    padding-top: 80px;
}

.code-field {
    align-self: stretch;
    margin: 48px 0 0 0;
    --unity-selection-color: rgba(46, 196, 182, 0.3);
    --unity-cursor-color: #2B2D42;
}

.code-field > .unity-base-text-field__input,
.code-field.unity-base-text-field:hover:enabled > .unity-base-text-field__input {
    height: 224px;
    padding: 0 24px;
    border-width: 6px;
    border-radius: 56px;
    border-color: var(--color-divider);
    background-color: #FFF8EF;
    color: var(--color-ink);
    font-size: 128px;
    letter-spacing: 18px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.code-field.unity-base-text-field:focus:enabled > .unity-base-text-field__input {
    border-color: var(--color-teal);
}

.lobby-body {
    flex-grow: 1;
    margin: 40px 56px 0 56px;
}

.code-card {
    align-items: center;
    flex-shrink: 0;
    padding: 56px 56px 48px 56px;
    border-radius: 72px;
    border-bottom-width: 20px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.code-card__code {
    margin-top: 8px;
    font-size: 150px;
    letter-spacing: 22px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.code-card .online-pair {
    align-self: stretch;
    margin-top: 32px;
}

.code-card__expiry {
    flex-direction: row;
    align-items: center;
    margin-top: 28px;
}

.code-card__expiry .icon {
    width: 48px;
    height: 48px;
    margin-right: 12px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.code-card__expiry-label {
    color: var(--color-ink-muted);
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.lobby-slots {
    flex-shrink: 0;
    margin-top: 56px;
}

.slot {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 232px;
    margin-bottom: 32px;
    padding: 0 36px 14px 36px;
    border-radius: 64px;
    border-bottom-width: 14px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.slot--waiting {
    padding-bottom: 0;
    border-width: 6px;
    border-color: var(--color-card-edge);
    background-color: rgba(255, 255, 255, 0.45);
}

.slot__ball {
    width: 160px;
    height: 160px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.slot__dots {
    width: 160px;
    flex-shrink: 0;
    color: var(--color-card-edge);
    font-size: 80px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.slot__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 36px;
}

.slot__name {
    font-size: 58px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.slot__sub {
    color: var(--color-ink-muted);
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.ready-mark {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 48px;
    background-color: var(--color-track-off);
}

.ready-mark .icon {
    width: 60px;
    height: 60px;
    -unity-background-image-tint-color: #FFFFFF;
}

.ready-mark--on {
    background-color: var(--color-teal);
}

.versus {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.pcard {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    height: 500px;
    padding: 48px 24px 0 24px;
    border-radius: 64px;
    border-top-width: 18px;
    border-bottom-width: 14px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.pcard--p0 { border-top-color: var(--color-player-0); }
.pcard--p1 { border-top-color: var(--color-player-1); }

.pcard__ball {
    width: 230px;
    height: 230px;
    -unity-background-scale-mode: scale-to-fit;
}

.pcard__name {
    margin-top: 20px;
    font-size: 50px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.pcard__sub {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
}

.pcard__sub .icon {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    -unity-background-image-tint-color: #12695F;
}

.pcard__sub-label {
    color: var(--color-ink-muted);
    font-size: 38px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
}

.pcard .ready-mark {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 80px;
    height: 80px;
    border-radius: 40px;
}

.pcard .ready-mark .icon {
    width: 50px;
    height: 50px;
}

.versus__label {
    width: 112px;
    flex-shrink: 0;
    color: var(--color-ink-muted);
    font-size: 64px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.lobby-center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.lobby-count {
    color: var(--color-coral);
    font-size: 400px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
    scale: 1 1;
    transition-property: scale;
    transition-duration: 320ms;
    transition-timing-function: ease-out-back;
}

.lobby-count--pop {
    scale: 1.25 1.25;
    transition-duration: 40ms;
}

.lobby-status {
    align-self: stretch;
    flex-shrink: 0;
    white-space: normal;
}

.lobby-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 56px 64px 56px;
}

.lobby-footer > .ink-chip {
    flex-shrink: 1;
}

.lobby-ready {
    flex-grow: 1;
    height: 192px;
    margin-left: 32px;
    background-color: var(--color-teal-edge);
}

.lobby-ready > .btn__face {
    bottom: 18px;
    background-color: var(--color-teal);
}

.lobby-ready:active > .btn__face {
    translate: 0 14px;
}

.lobby-ready .btn__label {
    font-size: 64px;
}

.lobby-ready .icon {
    width: 72px;
    height: 72px;
}

.lobby-ready--on {
    background-color: var(--color-surface-edge);
}

.lobby-ready--on > .btn__face {
    background-color: var(--color-surface);
    border-width: 4px;
    border-color: var(--color-divider);
}

.lobby-ready--on .btn__label {
    color: var(--color-ink);
}

.reconnect-ring {
    width: 240px;
    height: 240px;
    align-items: center;
    justify-content: center;
    border-width: 16px;
    border-radius: 120px;
    border-color: var(--color-teal);
}

.reconnect-ring__count {
    font-size: 104px;
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.reconnect-title {
    margin-top: 36px;
}
