.root {
    flex-grow: 1;
    color: var(--color-ink);
    font-size: var(--font-size-body);
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_semibold_sdf.asset");
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 220ms, 220ms;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.screen--hidden {
    opacity: 0;
    translate: 0 48px;
}

.screen--solid {
    background-color: var(--color-bg);
}

.safe {
    flex-grow: 1;
}

.spacer {
    flex-grow: 1;
}

.unity-label {
    padding: 0;
    margin: 0;
}

.btn {
    margin: 0;
    padding: 0;
    border-width: 0;
    flex-shrink: 0;
    border-radius: var(--radius-button);
    background-color: var(--color-surface-edge);
}

.btn__face {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-button);
    background-color: var(--color-surface);
    transition-property: translate;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.btn:active > .btn__face {
    translate: 0 12px;
}

.btn:disabled {
    opacity: 0.4;
}

.btn__label {
    margin-left: 24px;
    color: #FFFFFF;
    font-size: var(--font-size-button);
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.btn--icon {
    width: 176px;
    height: 176px;
    border-radius: var(--radius-icon);
}

.btn--icon > .btn__face {
    border-radius: var(--radius-icon);
}

.btn--play {
    width: 416px;
    height: 444px;
    border-radius: 208px;
    background-color: var(--color-sun-edge);
}

.btn--play > .btn__face {
    bottom: 28px;
    border-radius: 208px;
    background-color: var(--color-sun);
}

.btn--play:active > .btn__face {
    translate: 0 22px;
}

.btn--play .icon {
    width: 176px;
    height: 176px;
    margin-left: 20px;
    -unity-background-image-tint-color: #2B2D42;
}

.btn--primary {
    flex-grow: 1;
    height: 208px;
    margin-left: 32px;
    background-color: var(--color-coral-edge);
}

.btn--primary > .btn__face {
    bottom: 20px;
    background-color: var(--color-coral);
}

.btn--primary:active > .btn__face {
    translate: 0 16px;
}

.btn--secondary {
    width: 208px;
    height: 208px;
}

.btn--secondary > .btn__face {
    bottom: 20px;
    border-width: 6px;
    border-color: var(--color-divider);
}

.btn--secondary:active > .btn__face {
    translate: 0 16px;
}

.btn--pill {
    width: 320px;
    height: 128px;
    border-radius: 64px;
}

.btn--pill > .btn__face {
    bottom: 12px;
    border-radius: 64px;
    border-width: 4px;
    border-color: var(--color-coral-soft);
}

.btn--pill:active > .btn__face {
    translate: 0 8px;
}

.btn--pill .btn__label {
    margin-left: 0;
    color: var(--color-coral);
    font-size: var(--font-size-caption);
}

.btn--pill.is-armed {
    background-color: var(--color-coral-edge);
}

.btn--pill.is-armed > .btn__face {
    border-color: var(--color-coral);
    background-color: var(--color-coral);
}

.btn--pill.is-armed .btn__label {
    color: #FFFFFF;
}

.icon {
    width: 88px;
    height: 88px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-ink);
}

.icon--light {
    -unity-background-image-tint-color: #FFFFFF;
}

.icon--back { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_back.svg"); }
.icon--check { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_check.svg"); }
.icon--chevron-left { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_chevron_left.svg"); }
.icon--chevron-right { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_chevron_right.svg"); }
.icon--clock { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_clock.svg"); }
.icon--flame { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_flame.svg"); }
.icon--lock { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_lock.svg"); }
.icon--wardrobe { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_wardrobe.svg"); }
.icon--crown { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_crown.svg"); }
.icon--drag { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_drag.svg"); }
.icon--home { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_home.svg"); }
.icon--pause { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_pause.svg"); }
.icon--play { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_play.svg"); }
.icon--rank { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_rank.svg"); }
.icon--retry { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_retry.svg"); }
.icon--settings { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_settings.svg"); }
.icon--trash { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_trash.svg"); }
.icon--vibration { background-image: url("/Assets/_Game/Art/UI/Icons/ui_icon_vibration.svg"); }

.caption {
    color: var(--color-ink-muted);
    font-size: var(--font-size-caption);
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_medium_sdf.asset");
    -unity-text-align: middle-center;
}

.chip {
    flex-direction: row;
    align-items: center;
    align-self: center;
    height: 128px;
    padding: 0 48px 0 36px;
    border-radius: 64px;
    border-bottom-width: 12px;
    border-color: var(--color-surface-edge);
    background-color: var(--color-surface);
}

.chip .icon {
    width: 72px;
    height: 72px;
    margin-right: 20px;
    -unity-background-image-tint-color: var(--color-teal);
}

.chip__label {
    font-size: var(--font-size-body);
}

.scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-scrim);
}

.overlay {
    align-items: center;
    justify-content: center;
}

.card {
    align-self: stretch;
    margin: 0 96px;
    align-items: center;
    padding: 176px 72px 72px 72px;
    border-radius: var(--radius-card);
    border-bottom-width: 28px;
    border-color: var(--color-card-edge);
    background-color: var(--color-surface);
    scale: 1 1;
    transition-property: scale;
    transition-duration: 320ms;
    transition-timing-function: ease-out-back;
}

.screen--hidden .card {
    scale: 0.92 0.92;
}

.card__mascot {
    position: absolute;
    top: -168px;
    left: 50%;
    width: 336px;
    height: 336px;
    margin-left: -168px;
    -unity-background-scale-mode: scale-to-fit;
}

.card__title {
    font-size: var(--font-size-title);
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.card__subtitle {
    margin-top: 8px;
}

.card__label {
    margin-top: 40px;
}

.card__number {
    margin-top: -16px;
    color: var(--color-coral);
    font-size: var(--font-size-number);
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
    -unity-text-align: middle-center;
}

.card__actions {
    flex-direction: row;
    align-self: stretch;
    margin-top: 64px;
}

.badge {
    position: absolute;
    top: 400px;
    right: -40px;
    rotate: 8deg;
    padding: 12px 36px;
    border-radius: 32px;
    border-bottom-width: 10px;
    border-color: var(--color-sun-edge);
    background-color: var(--color-sun);
    color: var(--color-ink);
    font-size: var(--font-size-caption);
    -unity-font-definition: url("/Assets/_Game/Fonts/fnt_fredoka_bold_sdf.asset");
}

.switch {
    width: 192px;
    height: 112px;
    flex-shrink: 0;
    border-radius: 56px;
    background-color: var(--color-track-off);
    transition-property: background-color;
    transition-duration: 160ms;
}

.switch__knob {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: #FFFFFF;
    transition-property: translate;
    transition-duration: 160ms;
    transition-timing-function: ease-out-cubic;
}

.switch--on {
    background-color: var(--color-teal);
}

.switch--on > .switch__knob {
    translate: 80px 0;
}
